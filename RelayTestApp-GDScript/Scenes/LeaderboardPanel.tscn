[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://Scripts/LeaderboardPanel.gd" id="1_lb"]

[node name="LeaderboardPanel" type="VBoxContainer"]
custom_minimum_size = Vector2(260, 0)
layout_mode = 2
theme_override_constants/separation = 4
script = ExtResource("1_lb")

[node name="TitleLabel" type="Label" parent="."]
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "Leaderboards"

[node name="BoardToggleRow" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 4

[node name="PointsButton" type="Button" parent="BoardToggleRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 11
text = "Most Opponents Beaten"

[node name="CoverageButton" type="Button" parent="BoardToggleRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 11
text = "Highest Coverage %"

[node name="PeriodToggleRow" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 4

[node name="LifetimeButton" type="Button" parent="PeriodToggleRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 11
text = "Lifetime"

[node name="QuarterlyButton" type="Button" parent="PeriodToggleRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 11
text = "Quarterly"

[node name="HSeparator" type="HSeparator" parent="."]
layout_mode = 2

[node name="EmptyLabel" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 11
theme_override_colors/font_color = Color(0.6, 0.6, 0.6, 1)
text = "No scores yet — be the first!"

[node name="Rows" type="VBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 2
